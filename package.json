{
  "name": "anything-reader",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:build": "node scripts/build-assets.mjs",
    "dev": "yarn assets:build && wxt",
    "dev:firefox": "yarn assets:build && wxt -b firefox",
    "build": "yarn assets:build && wxt build",
    "build:firefox": "yarn assets:build && wxt build -b firefox",
    "zip": "yarn assets:build && wxt zip",
    "zip:firefox": "yarn assets:build && wxt zip -b firefox",
    "compile": "yarn assets:build && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^29.1.1",
    "onnxruntime-web": "^1.26.0",
    "phonemizer": "1.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.20.25"
  }
}
